rules_version = '2';

// TradieConnect Firestore security rules.
//
// Principles:
//  - Everything requires authentication (no public access).
//  - Money / lifecycle collections (quotes, walletTransactions, notifications,
//    reporting rollups, ratings) are READ-only for clients; all writes go
//    through Cloud Functions, which use the Admin SDK and bypass these rules.
//  - User docs are writable only by their owner; admin changes (approve/suspend)
//    go through admin Cloud Functions.
//
// NOTE: Deploy with `npm run deploy:rules` and test the full app afterwards —
// these rules are stricter than the previous open ruleset.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // userType can't be changed by clients (see users rules), so this is safe.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin';
    }
    function changes(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // --- Users ---
    // Anyone signed in can read profiles (names/ratings are denormalized into
    // many views). A user may create/update only their own doc. Admin-only
    // changes (approval, suspension) run server-side via Cloud Functions.
    // Role, approval, money and reputation fields are server-only: a client
    // can't make itself admin, approve itself, or top up its own wallet.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) &&
        request.resource.data.userType in ['customer', 'tradie'] &&
        request.resource.data.get('walletBalance', 0) == 0 &&
        request.resource.data.get('isApproved', false) == false &&
        request.resource.data.get('rating', 0) == 0 &&
        request.resource.data.get('totalJobs', 0) == 0 &&
        !request.resource.data.keys().hasAny(['signupBonusGranted', 'status', 'approvedAt', 'approvedBy']);
      allow update: if isOwner(userId) &&
        !changes(['id', 'userType', 'phoneNumber', 'walletBalance', 'isApproved', 'approvedAt',
                  'approvedBy', 'signupBonusGranted', 'rating', 'totalJobs', 'status', 'createdAt']);
      allow delete: if false;
    }

    // --- Service requests ---
    // Customers create their own; owner can update (e.g. cancel). Status/lifecycle
    // changes from accept/complete run via Cloud Functions.
    // Read stays open to signed-in users because the tradie Explorer browses
    // requests. The owner may edit only the job details, and only before any
    // tradie has quoted; status changes go through Cloud Functions.
    match /serviceRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status == 'new';
      allow update: if isOwner(resource.data.customerId) &&
        resource.data.status == 'new' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'trades', 'description', 'postcode', 'urgency', 'photos', 'documents',
          'voiceMessage', 'searchKeywords', 'notesWords', 'descriptionLower', 'updatedAt']);
      allow delete: if false;
    }

    // --- Quotes --- CF-only writes (unlock / submitQuote / accept / decline).
    // Visible to the quoting tradie and the request's customer (customerId is
    // denormalized onto the quote), never to competing tradies.
    match /quotes/{quoteId} {
      allow read: if isSignedIn() &&
        (resource.data.tradieId == request.auth.uid ||
         resource.data.get('customerId', '') == request.auth.uid ||
         isAdmin());
      allow write: if false;
    }

    // --- Wallet transactions --- CF-only writes (recharge / unlock / bonus).
    match /walletTransactions/{txId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    // --- Chat rooms --- created by CF (submitQuote). Participants may update the
    // room (e.g. reset their unread counter) and post messages.
    // Only the two participants can see a conversation. Participants may only
    // reset their own unread counter on the room.
    match /chatRooms/{roomId} {
      function isParticipant() {
        let room = get(/databases/$(database)/documents/chatRooms/$(roomId)).data;
        return isSignedIn() &&
          (room.customerId == request.auth.uid || room.tradieId == request.auth.uid);
      }
      allow read: if isSignedIn() &&
        (resource.data.customerId == request.auth.uid ||
         resource.data.tradieId == request.auth.uid ||
         isAdmin());
      allow create: if false;
      allow update: if isSignedIn() &&
        ((resource.data.customerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadByCustomer'])) ||
         (resource.data.tradieId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadByTradie'])));

      match /messages/{messageId} {
        allow read: if isParticipant() || isAdmin();
        // Sender must be a participant (system messages come from CF).
        allow create: if isParticipant() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // --- Notifications --- created by CF; recipient may mark read.
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // --- Ratings --- CF-only writes (completeServiceRequest).
    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- Reviews --- CF-only writes (completeServiceRequest). Readable by any
    // signed-in user so customers can view a tradie's reviews before accepting.
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- Saved searches / job alerts --- owned by the tradie who created them.
    match /savedSearches/{searchId} {
      allow read: if isSignedIn() && resource.data.tradieId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.tradieId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.tradieId == request.auth.uid;
    }

    // --- Platform revenue --- CF-only writes; admin-only reads via functions.
    match /platformRevenue/{id} {
      allow read: if false;
      allow write: if false;
    }

    // --- Reporting rollups + intelligence --- read-only; CF/scheduled writes.
    match /suburbTradeStats/{id}  { allow read: if isSignedIn(); allow write: if false; }
    match /suburbStats/{id}       { allow read: if isSignedIn(); allow write: if false; }
    match /tradeStats/{id}        { allow read: if isSignedIn(); allow write: if false; }
    match /suburbAdjacency/{id}   { allow read: if isSignedIn(); allow write: if false; }
    match /requestIntelligence/{id} { allow read: if isSignedIn(); allow write: if false; }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
